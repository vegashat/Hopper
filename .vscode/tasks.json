{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hopper: API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/Hopper.Api/Hopper.Api.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Building.*$",
          "endsPattern": "^.*Now listening on: http://localhost:5154.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Hopper: Client",
      "type": "npm",
      "script": "start",
      "path": "Hopper.Client",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Building.*$",
          "endsPattern": "^.*(Application bundle generation complete|Local:\\s+http://localhost:4200/).*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Hopper: Run API + Client",
      "dependsOn": [
        "Hopper: API",
        "Hopper: Client"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
